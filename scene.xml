<mujoco model="franka_panda_scene">
    <compiler angle="radian" autolimits="true"/>

    <option integrator="RK4" timestep="0.002">
        <flag energy="enable"/>
    </option>

    <asset>
        <!-- Gökyüzü ve Zemin Dokuları -->
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4" width="300" height="300" mark="edge" markrgb="0.2 0.3 0.4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"/>
        
        <!-- Küp, Masa ve Hedef materyalleri -->
        <material name="table_mat" rgba="0.4 0.25 0.15 1.0"/>
        <material name="cube_mat" rgba="0.8 0.2 0.2 1.0"/>
        <material name="cube2_mat" rgba="0.2 0.45 0.9 1.0"/>
        <material name="cube3_mat" rgba="0.95 0.7 0.1 1.0"/>
        <material name="cube4_mat" rgba="0.55 0.25 0.8 1.0"/>
        <material name="cube5_mat" rgba="0.15 0.75 0.45 1.0"/>
        <material name="target_mat" rgba="0.2 0.8 0.2 0.5"/>
    </asset>

    <!-- Kök dizindeki franka_panda klasörüne yönlendiriyoruz -->
    <include file="assets/panda.xml"/>

    <worldbody>
        <!-- Işıklar -->
        <light pos="0 0 3" dir="0 0 -1" directional="true" castshadow="true"/>
        
        <!-- Zemin -->
        <geom name="floor" type="plane" size="0 0 0.05" material="grid" friction="1.0 0.01 0.001" condim="4"/>

        <!-- Masa (Table) -->
        <body name="table" pos="0.6 0.0 0.2">
            <geom name="table_top" type="box" size="0.25 0.35 0.2" material="table_mat" friction="1.2 0.02 0.002" condim="4"/>
        </body>

        <body name="cube" pos="0.55 0.0 0.42">
            <freejoint name="cube_joint"/>
            <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.1" material="cube_mat" friction="1.5 0.03 0.003" condim="6" solref="0.01 1" solimp="0.95 0.99 0.001"/>
        </body>

        <body name="cube2" pos="0.50 -0.14 0.42">
            <freejoint name="cube2_joint"/>
            <geom name="cube2_geom" type="box" size="0.02 0.02 0.02" mass="0.1" material="cube2_mat" friction="1.5 0.03 0.003" condim="6" solref="0.01 1" solimp="0.95 0.99 0.001"/>
        </body>

        <body name="cube3" pos="0.50 0.14 0.42">
            <freejoint name="cube3_joint"/>
            <geom name="cube3_geom" type="box" size="0.02 0.02 0.02" mass="0.1" material="cube3_mat" friction="1.5 0.03 0.003" condim="6" solref="0.01 1" solimp="0.95 0.99 0.001"/>
        </body>

        <body name="cube4" pos="0.59 -0.14 0.42">
            <freejoint name="cube4_joint"/>
            <geom name="cube4_geom" type="box" size="0.02 0.02 0.02" mass="0.1" material="cube4_mat" friction="1.5 0.03 0.003" condim="6" solref="0.01 1" solimp="0.95 0.99 0.001"/>
        </body>

        <body name="cube5" pos="0.59 0.14 0.42">
            <freejoint name="cube5_joint"/>
            <geom name="cube5_geom" type="box" size="0.02 0.02 0.02" mass="0.1" material="cube5_mat" friction="1.5 0.03 0.003" condim="6" solref="0.01 1" solimp="0.95 0.99 0.001"/>
        </body>

        <body name="target_marker" pos="0.65 0.0 0.402">
            <geom type="cylinder" size="0.027 0.002" material="target_mat" contype="0" conaffinity="0"/>
        </body>

        <!-- Kamera -->
        <camera name="front_camera" pos="1.2 0 0.8" xyaxes="0 1 0 -0.5 0 0.8"/>
    </worldbody>
</mujoco>
